{
  "name": "dian-einvoice-simulator",
  "private": true,
  "license": "MIT",
  "description": "Local simulator of the DIAN web service (SendBillSync, GetStatus) for development. It is not the DIAN.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "fix": "eslint --fix .",
    "test": "node --test --test-reporter=spec --test-timeout=20000 test/"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
