# The edge of the emulated cloud as a browser reaches it (compose service cloud-gateway): 127.0.0.1:8601, the web app
# and the API on one origin, as in production, and 127.0.0.1:8600, the address of the API, through the same edge. The
# emulator serves the CloudFront distribution of the stage local by its host name (<id>.cloudfront.localhost.floci.io)
# and runs no CloudFront Function, so this proxy does only what the emulator does not: it gives each request that
# host name, and rewrites the routes of the web app to /index.html as the function of the default behaviour does
# (infra/cdk/edge/panel-routes.js; make cloud-check runs the same cases, infra/cdk/edge/panel-routes.cases.json,
# through it). Everything else is the distribution's: its behaviours, the security headers of the web app, the secret
# of the edge, and API Gateway with the origin verifier. The proxy adds no header of its own, X-Forwarded-For
# included, so the distribution sees the client as CloudFront would. make cloud-up writes EDGE_HOST and
# EDGE_API_PATHS (the paths of backend/resources/http/paths.json as one regular expression) to
# infra/functions/.env.cloud. In AWS there is no such proxy: the domain of the platform points at the distribution.
server {
    listen 8000;
    server_tokens off;

    # The largest body API Gateway takes.
    client_max_body_size 10m;

    # The emulator is found again by name if it restarts with another address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $emulator floci;

    # The healthcheck of the container, which never wakes a function.
    location = /_gateway/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The paths of the API, as they are.
    location ~ ${EDGE_API_PATHS} {
        proxy_pass http://$emulator:4566;
        proxy_http_version 1.1;
        proxy_set_header Host ${EDGE_HOST};
        # Longer than the 30 s API Gateway gives an integration.
        proxy_read_timeout 35s;
        proxy_buffering off;
    }

    # Every other path is the web app: a path whose last segment has no extension is one of its routes.
    location / {
        rewrite ^(?:.*/)?[^/.]*$ /index.html break;
        proxy_pass http://$emulator:4566;
        proxy_http_version 1.1;
        proxy_set_header Host ${EDGE_HOST};
        proxy_read_timeout 35s;
    }
}
