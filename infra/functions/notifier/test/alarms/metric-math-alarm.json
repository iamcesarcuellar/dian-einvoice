  "StateChangeTime": "2026-11-20T21:00:30.123+0000",
  "Region": "US East (N. Virginia)",
  "AlarmArn": "arn:aws:cloudwatch:us-east-1:111111111111:alarm:dian-einvoice-prod-dian-error-rate",
