APP_NAME=dian-einvoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8601

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dian_einvoice
DB_USERNAME=dian
DB_PASSWORD=dian

# Sessions, cache and queue live in Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null

# The browser only sees the web app origin; Vite forwards /api, /sanctum and /docs to the API.
SANCTUM_STATEFUL_DOMAINS=localhost:8601,127.0.0.1:8601

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Left empty here: make fills it with a random value (scripts/env.sh) and compose gives the same one
# to the redis service, which has no published port and refuses to start without it.
REDIS_PASSWORD=
# Seconds after which a job taken by a worker that died is handed to another worker; longer than the
# worker --timeout of 35 s.
REDIS_QUEUE_RETRY_AFTER=45

# The DIAN of this project is always the local simulator (compose service simulator).
DIAN_SOAP_URL=http://simulator:8602/WcfDianCustomerServices.svc
DIAN_SIMULATOR_URL=http://simulator:8602
# The admin token of the simulator: left empty here, make fills it with a random value
# (scripts/env.sh) and compose gives the same one to the simulator, which refuses to start without it.
DIAN_SIMULATOR_TOKEN=
DIAN_TIMEOUT=8
DIAN_RETRY_DELAYS=2,5,15,45,120

# Email goes over SMTP to the local development mailbox (compose service mail, Mailpit), which keeps
# every message and relays none: nothing leaves this machine. Infrastructure only changes these values.
MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=documents@dian-einvoice.example
MAIL_FROM_NAME=dian-einvoice

# The local mailbox, a development tool: its web interface for people, and its API, which make seed
# clears and make delivery-check reads.
LOCAL_MAILBOX_URL=http://localhost:8603
LOCAL_MAILBOX_API_URL=http://mail:8025

# Public API (module Developers): requests per minute of an API key without its own limit; webhook
# attempts (5 s at most, retried with the waits of DIAN_RETRY_DELAYS unless WEBHOOK_RETRY_DELAYS is
# set). Private destinations are refused unless WEBHOOK_ALLOW_PRIVATE_TARGETS is true, which only local
# development sets, for the local webhook receiver; WEBHOOK_REQUIRE_HTTPS defaults to true in production.
API_KEY_RATE_LIMIT=120
WEBHOOK_TIMEOUT=5
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
LOCAL_WEBHOOK_RECEIVER_URL=http://simulator:8602/webhook-receiver
