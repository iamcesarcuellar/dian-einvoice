APP_NAME=dian-einvoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8601

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dian_einvoice
DB_USERNAME=dian
DB_PASSWORD=dian

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

# The browser only sees the web app origin; Vite forwards /api, /sanctum and /docs to the API.
SANCTUM_STATEFUL_DOMAINS=localhost:8601,127.0.0.1:8601

CACHE_STORE=database
QUEUE_CONNECTION=sync
